{
  "name": "vantage-ars",
  "version": "5.2.0",
  "private": true,
  "description": "Vantage-ARS: public site and founder-controlled, AI-staffed office (TanStack Start, Postgres).",
  "author": "Juan-louw Greyling <juanlouw.greyling@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 8080",
    "build": "vite build && npm run db:migrate",
    "build:ci": "npm run build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "db:migrate": "node scripts/migrate.mjs",
    "cf:check": "node scripts/cloudflare-check.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "VANTAGE_SKIP_DB_BOOTSTRAP=1 node --experimental-strip-types --import ./scripts/register-test-resolver.mjs --test --test-concurrency=4 \"scripts/**/*.test.mjs\" \"src/**/*.test.ts\" && node --experimental-strip-types --import ./scripts/register-test-resolver.mjs scripts/verify-office.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" vercel.json wrangler.jsonc .prettierrc",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" vercel.json wrangler.jsonc .prettierrc",
    "check": "npm run typecheck && npm run lint && npm test",
    "ci:verify": "npm run check && npm run build:ci",
    "validate": "npm run typecheck && npm run lint && npm test",
    "verify:office": "node --experimental-strip-types --import ./scripts/register-test-resolver.mjs scripts/verify-office.mjs"
  },
  "sideEffects": false,
  "overrides": {
    "nf3": "0.3.17",
    "react-hook-form": "$react-hook-form"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/router-plugin": "^1.168.48",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^5.2.0",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.0.0",
    "jose": "^6.2.13",
    "kysely": "^0.29.7",
    "lightningcss": "^1.28.0",
    "lucide-react": "^1.61.0",
    "nitro": "3.0.260610-beta",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.14.8",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.3.0",
    "vite": "^8.3.5",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
